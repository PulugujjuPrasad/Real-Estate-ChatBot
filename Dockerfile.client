# Build Stage
FROM node:20-alpine as build
WORKDIR /app

# Copy package files
COPY src/client/package*.json ./

# Install ALL dependencies (including devDeps for build)
RUN npm install

# Copy the entire client source folder
COPY src/client .

# Debug: List files to ensure they are in the right place
RUN ls -la

# Build the React app
RUN npm run build

# Production Stage
FROM nginx:alpine
# Vite builds to 'dist' folder by default
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
